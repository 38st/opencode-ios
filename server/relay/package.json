{
  "name": "@opencode-ios/push-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Push relay for opencode-ios: Hono on Cloudflare Workers with D1 and Durable Objects, plus a Node entry point.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start:node": "node src/node.ts",
    "dev": "node scripts/isolated.mjs wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "npm run typecheck && npm run test:workers && npm run test:node",
    "test:workers": "node scripts/isolated.mjs vitest run --config vitest.workers.config.ts",
    "test:node": "vitest run --config vitest.node.config.ts"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "26.6.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  }
}
