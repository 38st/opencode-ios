            "state" : "translated",
            "value" : "Opencode"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Why the app asks for the camera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opencode uses the camera to scan server pairing QR codes and attach photos to prompts."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Why the app asks for Face ID",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opencode verifies it is you before always allowing an action or approving a high-risk request."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Why the app asks for local network access",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opencode uses your local network to connect to opencode servers you choose on your computers."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Why the app asks for the microphone",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice input listens while you dictate a prompt. Recognition runs on this device and the audio never leaves it; only the text you send does."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Why the app asks to add photos",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save images from a conversation to your photo library."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Why the app asks for speech recognition",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice input turns your speech into prompt text on this device. The audio is not sent to Apple or to your server."
          }
        }
      }
    }
  },
  "version" : "1.0"
